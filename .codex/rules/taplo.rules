# TOML 格式化与检查。

prefix_rule(
    pattern = ["taplo"],
    decision = "allow",
    justification = "Format or check TOML files",
    match = [
        "taplo check",
        "taplo fmt --check",
    ],
    not_match = ["golangci-lint run"],
)

prefix_rule(
    pattern = ["rtk", "taplo"],
    decision = "allow",
    justification = "Format or check TOML files through RTK",
    match = ["rtk taplo fmt --check"],
    not_match = ["rtk golangci-lint run"],
)
